# ==============================================================================
# DAYFLOW - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as appropriate for your environment:
#   cp .env.example .env
#
# IMPORTANT: DO NOT commit your .env file containing secrets into version control.
# ==============================================================================

# Application Settings
PROJECT_NAME="Dayflow Backend API"
VERSION="v1"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Connection (Supabase PostgreSQL / Standard PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Security & JWT Token Configuration
SECRET_KEY="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Distributed AI Anomaly Microservice
AI_SERVICE_URL="http://localhost:8080"
AI_SERVICE_TIMEOUT_SECONDS=2.0

# Permitted CORS Origins (JSON Array)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "http://127.0.0.1:3000", "http://127.0.0.1:5173", "http://127.0.0.1:8000"]
